rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allowlisted accounts (marked `allowed` by the backend, see firestore.rules) can only
    // read/write files under their own path
    match /users/{uid}/projects/{projectId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.token.get('allowed', false) == true && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.token.get('allowed', false) == true && request.auth.uid == uid
                   && request.resource.size < 50 * 1024 * 1024  // 50MB max
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('video/.*')
                       || request.resource.contentType.matches('audio/.*'));
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
